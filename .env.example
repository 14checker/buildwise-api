DB_FILE=db.json
BUILDWISE_ENV=local
NODE_ENV=development
DRY_RUN=true
WRITE=false
MAX_OFFERS=25
CRAWL_DELAY_MS=61000
DRY_RUN_DELAY_MS=0
REQUIRE_APPROVED_SOURCE=false
AUTO_PROMOTE=false
AUTO_PROMOTE_EXACT=true
AUTO_PROMOTE_STRONG=true
AUTO_PROMOTE_MIN_SCORE=90
ALLOW_PROVISIONAL_PUBLIC=false
ALLOW_MARKETPLACE=false
ALLOW_REFURBISHED=false
PROMOTE_LIMIT=50
PIPELINE_MODE=safe_daily
DISCOVERY_MODE=auto
DISCOVERY_MAX_PRODUCTS=25
DISCOVERY_TARGET_OFFERS_PER_PRODUCT=3
DISCOVERY_RETAILERS=
DISCOVERY_STALE_HOURS=720
DISCOVERY_PRODUCT_ID=
DISCOVERY_RETAILER_ID=
DISCOVERY_CATEGORY=
DISCOVERY_CANDIDATE_FILE=
DISCOVERY_SEARCH_FIXTURE_DIR=
DISCOVERY_SEARCH_PROVIDER_FILE=
INGESTION_ALLOW_LIVE_FETCH=false
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_MS=500
HTTP_MAX_CONCURRENCY=2
HTTP_USER_AGENT=BuildWiseIngestion/0.1 contact: support@buildwise-pc.com
RETAILER_REQUEST_DELAY_MS=1000
TRACKER_EVERY_MINUTES=15
PRODUCTION_SYNC_EVERY_MINUTES=0
RUN_ON_START=true
PROMOTE_EVERY_MINUTES=15
DISCOVERY_EVERY_MINUTES=240
GROUP_EVERY_MINUTES=240
TRACKER_DRY_RUN=true
PROMOTE_DRY_RUN=true
DISCOVERY_DRY_RUN=true
TRACKER_MAX_OFFERS=25
BACKUP_DIR=backups
REPORT_DIR=buildwise_reports
EXPORT_DIR=buildwise_tracker_exports
PORT=8080
API_HOST=0.0.0.0
PUBLIC_API_BASE_URL=https://<buildwise-api-host>
CORS_ALLOWED_ORIGINS=https://<base44-app-origin>
BASE44_ALLOWED_ORIGINS=https://<base44-app-origin>
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
BUILDWISE_PRIVATE_API_KEY=<secret>
BUILDWISE_API_WRITE=false
